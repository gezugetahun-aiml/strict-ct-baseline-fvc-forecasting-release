+def patient_baseline_only_balance_summary(records, cfg):
+    """
+    One row per strict-cohort patient for Reviewer-2 OUTER-fold sensitivity.
+
+    Only variables available at the prediction origin are candidates for fold
+    assignment. Future target count, future horizon, PatientSlope, and rapid
+    status are retained only as DESCRIPTIVE columns in the returned table so
+    that the resulting folds can be audited after assignment; they never enter
+    the balancing vector.
+    """
+    if len(records) == 0:
+        return pd.DataFrame()
+
+    p = (
+        records.groupby("Patient")
+        .agg(
+            Age=("Age", "first"),
+            Sex=("Sex", "first"),
+            SmokingStatus=("SmokingStatus", "first"),
+            BaselineFVC=("BaselineFVC", "first"),
+            Percent=("Percent", "first"),
+            BaselineWeek=("BaselineWeek", "first"),
+            FSS=("FSS", "first"),
+            # Descriptive-only audit columns below; NOT used for assignment.
+            NTargets=("TargetFVC", "size"),
+            PatientSlope=("PatientSlope", "first"),
+            MeanHorizon=("TargetWeekFromCT", "mean"),
+            MaxHorizon=("TargetWeekFromCT", "max"),
+        )
+        .reset_index()
+    )
+
+    # Descriptive-only rapid status for post-assignment fold profiles.
+    slope_q = float(
+        np.quantile(
+            p["PatientSlope"].to_numpy(dtype=np.float64),
+            cfg.balance_rapid_decline_quantile,
+        )
+    )
+    p["RapidDecliner"] = (
+        p["PatientSlope"].to_numpy(dtype=np.float64) <= slope_q
+    ).astype(float)
+    return p
+
+
+def make_baseline_only_outer_folds(records, n_splits, cfg, seed):
+    """
+    Deterministic Reviewer-2 sensitivity outer folds using baseline-only data.
+
+    Assignment vector contains ONLY:
+      patient count, Age, BaselineFVC, Percent, BaselineWeek, FSS,
+      Sex one-hot indicators, and SmokingStatus one-hot indicators.
+
+    No future outcome or future observation-schedule quantity contributes to
+    assignment. Fold capacities are fixed to differ by at most one patient.
+    """
+    p = patient_baseline_only_balance_summary(records, cfg)
+    n_patients = len(p)
+    if n_patients < n_splits:
+        raise RuntimeError(
+            f"Cannot make {n_splits} baseline-only folds from {n_patients} patients."
+        )
+
+    # -------------------------
+    # Continuous baseline data.
+    # -------------------------
+    numeric_cols = [
+        "Age", "BaselineFVC", "Percent", "BaselineWeek", "FSS",
+    ]
+    X_num = p[numeric_cols].copy()
+    for col in numeric_cols:
+        vals = pd.to_numeric(X_num[col], errors="coerce").to_numpy(dtype=np.float64)
+        finite = np.isfinite(vals)
+        med = float(np.nanmedian(vals[finite])) if np.any(finite) else 0.0
+        vals[~finite] = med
+        mu = float(np.mean(vals))
+        sd = float(np.std(vals, ddof=0))
+        if (not np.isfinite(sd)) or sd < 1e-8:
+            sd = 1.0
+        X_num[col] = (vals - mu) / sd
+
+    blocks = [X_num.to_numpy(dtype=np.float64)]
+
+    # -----------------------------------
+    # Baseline categorical characteristics.
+    # -----------------------------------
+    for col in ["Sex", "SmokingStatus"]:
+        cats = p[col].fillna("Unknown").astype(str)
+        D = pd.get_dummies(cats, prefix=col, dtype=float)
+        if D.shape[1] > 0:
+            arr = D.to_numpy(dtype=np.float64)
+            mu = np.mean(arr, axis=0)
+            sd = np.std(arr, axis=0, ddof=0)
+            sd = np.where(sd < 1e-8, 1.0, sd)
+            arr = (arr - mu) / sd
+            # Give each categorical VARIABLE approximately one unit of total
+            # influence regardless of the number of dummy columns.
+            arr = arr / np.sqrt(float(max(arr.shape[1], 1)))
+            blocks.append(arr)
+
+    baseline_Z = np.column_stack(blocks)
+
+    V = np.column_stack([
+        np.ones(n_patients, dtype=np.float64)
+        * float(cfg.baseline_only_balance_weight_patient_count),
+        baseline_Z,
+    ])
+
+    desired = np.sum(V, axis=0) / float(n_splits)
+    fold_sums = np.zeros((n_splits, V.shape[1]), dtype=np.float64)
+    fold_members = [[] for _ in range(n_splits)]
+
+    # Fixed capacities guarantee 5--6 patients/fold for 29 patients and five
+    # folds; more generally, sizes differ by at most one.
+    base = n_patients // n_splits
+    extra = n_patients % n_splits
+    capacities = np.array(
+        [base + (1 if f < extra else 0) for f in range(n_splits)],
+        dtype=int,
+    )
+
+    rng = np.random.default_rng(seed)
+    extremeness = np.linalg.norm(V[:, 1:], axis=1)
+    jitter = rng.uniform(0.0, 1e-6, size=n_patients)
+    order = np.argsort(-(extremeness + jitter))
+
+    # Seed every fold once.
+    for f, idx in enumerate(order[:n_splits]):
+        fold_members[f].append(int(idx))
+        fold_sums[f] += V[idx]
+
+    for idx in order[n_splits:]:
+        candidates = [
+            f for f in range(n_splits)
+            if len(fold_members[f]) < int(capacities[f])
+        ]
+        if not candidates:
+            raise RuntimeError("Baseline-only fold assignment exhausted capacities.")
+
+        costs = []
+        for f in candidates:
+            trial = fold_sums.copy()
+            trial[f] += V[idx]
+            imbalance = np.sum((trial - desired.reshape(1, -1)) ** 2)
+            costs.append((float(imbalance), f))
+
+        best_cost = min(c for c, _ in costs)
+        tied = [
+            f for c, f in costs
+            if np.isclose(c, best_cost, rtol=1e-10, atol=1e-10)
+        ]
+        best = min(tied, key=lambda f: len(fold_members[f]))
+        fold_members[best].append(int(idx))
+        fold_sums[best] += V[idx]
+
+    result = []
+    all_patients = set(p["Patient"].astype(str).tolist())
+    for f, member_idx in enumerate(fold_members):
+        val_patients = set(p.iloc[member_idx]["Patient"].astype(str).tolist())
+        train_patients = all_patients - val_patients
+        sub = p[p["Patient"].astype(str).isin(val_patients)].copy()
+
+        # NOTE: target count, slope, rapid status, and horizon below are
+        # DESCRIPTIVE AFTER assignment and had no influence on fold creation.
+        summary = {
+            "Fold": f + 1,
+            "Patients": int(len(sub)),
+            "Targets": int(sub["NTargets"].sum()),
+            "MeanAge": float(sub["Age"].mean()),
+            "MaleRate": float(np.mean(sub["Sex"].astype(str).str.lower() == "male")),
+            "MeanBaselineFVC": float(sub["BaselineFVC"].mean()),
+            "MeanPercent": float(sub["Percent"].mean()),
+            "MeanBaselineWeek": float(sub["BaselineWeek"].mean()),
+            "MeanFSS": float(sub["FSS"].mean()),
+            "MeanSlope_DESCRIPTIVE_ONLY": float(sub["PatientSlope"].mean()),
+            "RapidRate_DESCRIPTIVE_ONLY": float(sub["RapidDecliner"].mean()),
+            "MeanHorizon_DESCRIPTIVE_ONLY": float(
+                np.average(
+                    sub["MeanHorizon"],
+                    weights=np.maximum(sub["NTargets"], 1),
+                )
+            ),
+            "AssignmentUsedFutureInformation": False,
+        }
+        result.append({
+            "train_patients": train_patients,
+            "val_patients": val_patients,
+            "summary": summary,
+        })
+
+    # Defensive invariants for the sensitivity analysis.
+    assigned = set().union(*[x["val_patients"] for x in result])
+    if assigned != all_patients:
+        raise RuntimeError("Baseline-only outer folds did not cover all patients exactly once.")
+    counts = [len(x["val_patients"]) for x in result]
+    if max(counts) - min(counts) > 1:
+        raise RuntimeError(f"Unexpected fold-size spread: {counts}")
+
+    return result
+
